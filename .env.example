# Rights Desk uses the PayPal Sandbox only. Keep these values out of Git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional local classifier. Install/pull gemma3:4b in Ollama first.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional alternate data directory for isolated testing.
# DATA_DIR=/private/tmp/rights-desk-qa
# PORT=5189
