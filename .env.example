# Rights Desk uses PayPal Sandbox only. Supply actual values through the
# server environment or the macOS Keychain references documented in README.
# Keep actual credentials out of repository files, including ignored .env files.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional local classifier. Install/pull gemma3:4b in Ollama first.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional alternate data directory for isolated testing.
# DATA_DIR=/private/tmp/rights-desk-qa
# PORT=5189
